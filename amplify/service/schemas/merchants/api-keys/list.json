{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /merchants/api-keys/list",
  "$comment": "The query string: every key, users' and merchants', narrowed by any of these filters (D2.6; the table is scanned while it is small).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "merchantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ownerType": {
      "type": "string",
      "enum": [
        "user",
        "merchant"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ]
    }
  }
}
