{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POST /merchants/api-keys/revoke",
  "$comment": "Staff revoke any key, saying why; the owner is told the reason.",
  "type": "object",
  "required": [
    "keyId",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "keyId": {
      "type": "string",
      "pattern": "^lk_live_[0-9a-f]{16}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    }
  }
}
